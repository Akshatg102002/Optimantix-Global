
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: inclusive write access is for development/demo only.
    // If you enable Firebase Auth later, revert to: allow write: if request.auth != null;
    match /{document=**} {
      allow read: if true;
      allow write: if true; 
    }
  }
}
